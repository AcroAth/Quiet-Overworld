{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quiet Overworld",
  "version": "0.1.0",
  "identifier": "io.github.acroath.quietoverworld",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Quiet Overworld",
        "width": 380,
        "height": 640,
        "minWidth": 320,
        "minHeight": 460,
        "create": false,
        "backgroundColor": "#1b1d1f"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Minecraft's music, without the game",
    "longDescription": "Plays Minecraft's background music the way the game does: a random track from the overworld soundtrack, then minutes of quiet. Lives in the system tray.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "android": {
      "minSdkVersion": 26
    }
  }
}
